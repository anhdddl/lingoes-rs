{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/parity-ledger.schema.json",
  "title": "Parity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_source", "artifacts", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "matrix_source": { "$ref": "#/$defs/nonEmptyString" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kind": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflow",
        "evidence_paths",
        "evidence_status",
        "implementation_status",
        "automated_tests",
        "windows_scenarios",
        "supported_platforms",
        "owner",
        "acceptance",
        "deviation",
        "evidence_artifacts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
        "workflow": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_paths": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence_status": {
          "enum": ["inferred", "observed-static", "observed-runtime", "not-applicable"]
        },
        "implementation_status": {
          "enum": ["implemented", "verified", "deferred", "not-applicable"]
        },
        "automated_tests": { "$ref": "#/$defs/nonEmptyStrings" },
        "windows_scenarios": { "$ref": "#/$defs/nonEmptyStrings" },
        "supported_platforms": { "$ref": "#/$defs/nonEmptyStrings" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "acceptance": { "$ref": "#/$defs/nonEmptyString" },
        "deviation": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_artifacts": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
