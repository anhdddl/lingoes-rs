import "./fonts/NotoSans-Regular.ttf";
import "./fonts/NotoSans-Bold.ttf";
import { Button, ScrollView } from "std-widgets.slint";

// A standalone lookup surface. AppWindow keeps its legacy quick-popup API
// until the Rust controller is migrated to own this window.
export component PopupWindow inherits Window {
    default-font-family: "Noto Sans";
    title: root.headword == "" ? "Lingoes quick lookup" : (root.headword + " — Lingoes");
    preferred-width: root.expanded ? 560px : 340px;
    preferred-height: root.expanded ? 480px : 180px;
    min-width: 320px;
    min-height: 180px;
    background: #ffffff;
    forward-focus: keyboard;

    in property <string> ui-lang: "vi";
    in property <string> headword;
    in property <string> definition;
    in property <string> dictionary-name;
    in property <string> status-text;
    in property <bool> can-go-previous: false;
    in property <bool> can-go-next: false;
    in property <bool> pinned: false;
    in property <bool> expanded: false;

    callback previous();
    callback next();
    callback copy();
    callback speak();
    callback stop();
    callback pin(bool);
    callback expand(bool);
    callback open-main();
    callback close();

    keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Rectangle {
            height: 42px;
            background: #0b3558;
            border-radius: 6px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 6px;

                Text {
                    text: root.headword == "" ? (root.ui-lang == "vi" ? "Tra nhanh" : "Quick lookup") : root.headword;
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Button {
                    text: root.pinned ? (root.ui-lang == "vi" ? "Bỏ ghim" : "Unpin") : (root.ui-lang == "vi" ? "Ghim" : "Pin");
                    accessible-label: root.pinned ? "Unpin quick lookup window" : "Pin quick lookup window";
                    clicked => { root.pin(!root.pinned); }
                }
                Button {
                    text: root.ui-lang == "vi" ? "Đóng" : "Close";
                    accessible-label: "Close quick lookup window";
                    clicked => { root.close(); }
                }
            }
        }

        if root.dictionary-name != "" : Text {
            text: root.dictionary-name;
            color: #334155;
            font-size: 13px;
            font-weight: 700;
            overflow: elide;
        }

        Rectangle {
            background: #ffffff;
            border-color: #475569;
            border-width: 1px;
            border-radius: 6px;
            vertical-stretch: 1;

            ScrollView {
                viewport-width: self.width;

                Text {
                    width: parent.width;
                    text: root.definition == "" ? (root.ui-lang == "vi" ? "Chưa có định nghĩa tra cứu." : "No definition available.") : root.definition;
                    color: #111827;
                    font-size: root.expanded ? 16px : 14px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }

        if root.expanded && root.status-text != "" : Text {
            text: root.status-text;
            color: #334155;
            font-size: 13px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            height: 38px;
            spacing: 6px;

            Button {
                text: root.ui-lang == "vi" ? "Trước" : "Previous";
                accessible-label: root.ui-lang == "vi" ? "Kết quả trước" : "Previous lookup result";
                enabled: root.can-go-previous;
                clicked => { root.previous(); }
            }
            Button {
                text: root.ui-lang == "vi" ? "Tiếp" : "Next";
                accessible-label: root.ui-lang == "vi" ? "Kết quả kế tiếp" : "Next lookup result";
                enabled: root.can-go-next;
                clicked => { root.next(); }
            }
            Button {
                text: root.ui-lang == "vi" ? "Sao chép" : "Copy";
                accessible-label: root.ui-lang == "vi" ? "Sao chép kết quả" : "Copy lookup result";
                clicked => { root.copy(); }
            }
            Button {
                text: root.ui-lang == "vi" ? "Phát âm" : "Speak";
                accessible-label: root.ui-lang == "vi" ? "Phát âm từ" : "Speak headword";
                clicked => { root.speak(); }
            }
            Button {
                text: root.ui-lang == "vi" ? "Dừng" : "Stop";
                accessible-label: root.ui-lang == "vi" ? "Dừng giọng nói" : "Stop speech";
                clicked => { root.stop(); }
            }

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: root.expanded ? (root.ui-lang == "vi" ? "Thu gọn" : "Compact") : (root.ui-lang == "vi" ? "Mở rộng" : "Expand");
                accessible-label: root.expanded ? (root.ui-lang == "vi" ? "Dạng thu gọn" : "Use compact view") : (root.ui-lang == "vi" ? "Dạng mở rộng" : "Use expanded view");
                clicked => { root.expand(!root.expanded); }
            }
            if root.expanded : Button {
                text: root.ui-lang == "vi" ? "Màn hình chính" : "Open main";
                accessible-label: root.ui-lang == "vi" ? "Mở kết quả trong cửa sổ chính" : "Open result in main window";
                clicked => { root.open-main(); }
            }
        }
    }
}