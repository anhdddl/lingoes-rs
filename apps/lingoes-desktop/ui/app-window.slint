import "./fonts/NotoSans-Regular.ttf";
import "./fonts/NotoSans-Bold.ttf";
import { CheckBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";
export struct SearchResult { headword: string, definition: string, dictionary-name: string, }
export struct DictionaryItem { id: int, name: string, format: string, entry-count: int, enabled: bool, }
export struct FormattedEntryLine {
    kind: string,
    prefix: string,
    body: string,
}

component ClassicButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    callback clicked;
    height: 24px;
    min-width: 42px;
    border-radius: 3px;
    background: !root.enabled ? #eef3f7 : root.selected ? #bddcf3 : hit.has-hover ? #f4f8fc : #e4edf5;
    border-color: !root.enabled ? #c2d2df : root.selected ? #3f80ab : hit.has-hover ? #6e94b3 : #8eaec7;
    border-width: 1px;
    Text {
        text: root.text;
        color: root.enabled ? (root.selected ? #0b375d : #174d7b) : #8599a8;
        font-family: "Noto Sans";
        font-size: 11px;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 4px;
        width: parent.width - 8px;
        height: parent.height;
        overflow: elide;
    }
    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component CircleNavButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    width: 25px;
    height: 25px;
    border-radius: 12px;
    background: !root.enabled ? #edf2f6 : hit.has-hover ? #f6fafd : #e5eff7;
    border-color: !root.enabled ? #c7d5e1 : hit.has-hover ? #5b8dae : #8ca6bd;
    border-width: 1px;
    Text {
        text: root.text;
        color: root.enabled ? #174d7b : #9cb1c2;
        font-family: "Noto Sans";
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component BookIcon inherits Rectangle {
    width: 15px;
    height: 13px;
    background: transparent;
    Rectangle { x: 1px; y: 2px; width: 6px; height: 9px; background: #f8fbfd; border-color: #4f7899; border-width: 1px; border-radius: 1px; }
    Rectangle { x: 8px; y: 2px; width: 6px; height: 9px; background: #f8fbfd; border-color: #4f7899; border-width: 1px; border-radius: 1px; }
    Rectangle { x: 7px; y: 1px; width: 1px; height: 11px; background: #4f7899; }
    Rectangle { x: 3px; y: 4px; width: 3px; height: 1px; background: #a9bfd0; }
    Rectangle { x: 9px; y: 4px; width: 3px; height: 1px; background: #a9bfd0; }
}

component SearchActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    min-width: 74px;
    border-radius: 3px;
    background: !root.enabled ? #93b5d1 : hit.has-hover ? #2c8ee0 : #1d74be;
    border-color: #125187;
    border-width: 1px;
    Text {
        text: root.text;
        color: white;
        font-family: "Noto Sans";
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 4px;
        width: parent.width - 8px;
    }
    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TopTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    background: root.selected ? white : hit.has-hover ? #eaf2f9 : transparent;
    border-color: root.selected ? #8aa8be : transparent;
    border-width: root.selected ? 1px : 0px;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: root.selected ? #0e375e : #234c73;
            font-family: "Noto Sans";
            font-size: 11px;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    if root.selected : Rectangle {
        y: 0px;
        height: 2px;
        background: #1d74be;
    }
    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
component MenuBarItem inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    callback clicked;
    height: 18px;
    border-radius: 2px;
    background: is-active ? #b9d7f0 : (mhit.has-hover ? #d1e5f5 : transparent);
    border-color: is-active ? #78a8cf : (mhit.has-hover ? #a5c7e4 : transparent);
    border-width: 1px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: #173f61;
            font-family: "Noto Sans";
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    mhit := TouchArea {
        clicked => { root.clicked(); }
    }
}

component MenuDropdownItem inherits Rectangle {
    in property <string> text;
    in property <string> shortcut: "";
    in property <string> icon-text: "";
    in property <bool> is-separator: false;
    in property <bool> is-checked: false;
    callback clicked;
    height: root.is-separator ? 7px : 24px;
    background: root.is-separator ? transparent : (dhit.has-hover ? #2e75b6 : transparent);
    if root.is-separator : Rectangle {
        y: 3px;
        height: 1px;
        background: #d8e2eb;
    }
    if !root.is-separator : HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.is-checked ? "✓" : root.icon-text;
            width: 16px;
            color: dhit.has-hover ? white : #174d7b;
            font-family: "Noto Sans";
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: dhit.has-hover ? white : #173f61;
            font-family: "Noto Sans";
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.shortcut != "" : Text {
            text: root.shortcut;
            color: dhit.has-hover ? #d2e4f5 : #78909c;
            font-family: "Noto Sans";
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    dhit := TouchArea {
        enabled: !root.is-separator;
        clicked => { if !root.is-separator { root.clicked(); } }
    }
}

component SectionTitle inherits Rectangle { in property <string> text; height: 27px; background: #d8e9f6; border-color: #9ebbd0; border-width: 1px; Text { text: root.text; x: 7px; width: parent.width - 14px; height: parent.height; color: #174d7b; font-family: "Noto Sans"; font-size: 12px; font-weight: 700; vertical-alignment: center; } }
