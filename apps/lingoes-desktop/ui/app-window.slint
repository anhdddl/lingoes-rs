     }
    } }
    Rectangle { horizontal-stretch: 1; background: #f5f8fa; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px;
     Rectangle { height: 29px; background: #eef5fb; border-color: #b4cbe0; border-width: 1px; HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px; Text { text: root.selected-headword == "" ? (root.ui-lang == "vi" ? "Trang chủ" : "Start Page") : root.selected-headword; color: #10385c; font-family: "Noto Sans"; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; } if root.selected-dict-badge != "" : Text { text: "[" + root.selected-dict-badge + "]"; color: #58758b; font-family: "Noto Sans"; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } ClassicButton { text: root.ui-lang == "vi" ? "Phát âm" : "Speak"; width: root.ui-lang == "vi" ? 62px : 50px; height: 22px; enabled: root.selected-headword != ""; clicked => { root.speak(root.selected-headword, "en"); } } ClassicButton { text: root.ui-lang == "vi" ? "Dừng" : "Stop"; width: 44px; height: 22px; clicked => { root.stop-tts(); } } ClassicButton { text: root.ui-lang == "vi" ? "Sao chép" : "Copy"; width: root.ui-lang == "vi" ? 64px : 46px; height: 22px; enabled: root.selected-headword != ""; clicked => { root.copy-to-clipboard(root.selected-headword + "\n" + root.selected-definition); } } ClassicButton { text: root.ui-lang == "vi" ? "Lưu" : "Save"; width: 44px; height: 22px; enabled: root.selected-headword != ""; clicked => { root.export-result-html(); } } ClassicButton { text: root.ui-lang == "vi" ? "Tìm FTS" : "Find"; width: root.ui-lang == "vi" ? 58px : 42px; height: 22px; clicked => { root.full-text-search(root.query); } } } }
     Rectangle { vertical-stretch: 1; background: #fffdf0; ScrollView { VerticalLayout { padding: 8px; spacing: 8px;
      if root.selected-headword != "" : Rectangle { background: #fffef8; border-color: #b9d2e7; border-width: 1px; border-radius: 2px;
       VerticalLayout { spacing: 0px;
        Rectangle { height: 23px; background: #dcebf8; border-top-left-radius: 2px; border-top-right-radius: 2px; border-color: #9fbbd4; border-width: 1px; HorizontalLayout { padding-left: 7px; padding-right: 7px; spacing: 6px; BookIcon { } Text { text: root.selected-dict-badge != "" ? root.selected-dict-badge : (root.ui-lang == "vi" ? "Từ điển" : "Dictionary"); color: #174d7b; font-family: "Noto Sans"; font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: "⌃"; color: #58758b; font-size: 10px; vertical-alignment: center; } } }
        VerticalLayout { padding-left: 18px; padding-right: 14px; padding-top: 10px; padding-bottom: 14px; spacing: 4px;
         for line in root.definition-lines : HorizontalLayout { spacing: 6px;
          if line.kind == "headword" : Text { text: line.body; font-family: "Noto Sans"; font-size: 15px; font-weight: 700; color: #102a43; }
          if line.kind == "phonetic" : Text { text: line.body; font-family: "Noto Sans"; font-size: 12px; color: #2c9a28; }
          if line.kind == "pos" : HorizontalLayout { spacing: 5px; Text { text: line.prefix; color: #d74e3a; font-size: 9px; vertical-alignment: center; } Text { text: line.body; font-family: "Noto Sans"; font-size: 11px; font-italic: true; color: #d74e3a; } }
          if line.kind == "section" : HorizontalLayout { spacing: 5px; Text { text: line.prefix; color: #3d76a5; font-size: 9px; vertical-alignment: center; } Text { text: line.body; font-family: "Noto Sans"; font-size: 11px; font-weight: 700; color: #245f91; } }
          if line.kind == "sense" : HorizontalLayout { spacing: 5px; if line.prefix != "" : Text { text: line.prefix; font-family: "Noto Sans"; font-size: 11px; font-weight: 700; color: #168a82; min-width: 18px; } Text { text: line.body; font-family: "Noto Sans"; font-size: 11px; color: #202020; wrap: word-wrap; horizontal-stretch: 1; } }
          if line.kind == "example" : HorizontalLayout { padding-left: 12px; spacing: 5px; Text { text: line.prefix; font-size: 10px; color: #397fb7; } Text { text: line.body; font-family: "Noto Sans"; font-size: 11px; font-italic: true; color: #555555; wrap: word-wrap; horizontal-stretch: 1; } }
          if line.kind == "bullet" : HorizontalLayout { padding-left: 12px; spacing: 5px; Text { text: line.prefix; font-size: 10px; color: #78909c; } Text { text: line.body; font-family: "Noto Sans"; font-size: 11px; color: #455a64; wrap: word-wrap; horizontal-stretch: 1; } }
          if line.kind != "headword" && line.kind != "phonetic" && line.kind != "pos" && line.kind != "section" && line.kind != "sense" && line.kind != "example" && line.kind != "bullet" : Text { text: line.body; font-family: "Noto Sans"; font-size: 11px; color: #263238; wrap: word-wrap; }
         }
         if root.definition-lines.length == 0 : Text { text: root.selected-definition; font-family: "Noto Sans"; font-size: 11px; color: #172f43; wrap: word-wrap; }
        }
       }
      }
      if root.selected-headword == "" : Rectangle { background: #fffef8; border-color: #b9d2e7; border-width: 1px; border-radius: 2px; VerticalLayout { padding: 18px; spacing: 10px; Text { text: root.ui-lang == "vi" ? "Chào mừng đến với Lingoes RS" : "Welcome to Lingoes RS"; font-family: "Noto Sans"; font-size: 15px; font-weight: 700; color: #174d7b; } Text { text: root.ui-lang == "vi" ? "Nhập từ hoặc cụm từ vào ô tìm kiếm ở trên, sau đó nhấn Enter hoặc bấm Tra từ (▶).\n\nSử dụng danh sách Kết quả hoặc Lịch sử bên trái, và quản lý các bộ từ điển bổ sung tại thẻ Quản lý từ điển." : "Enter a word or phrase in the search box above, then press Enter or click Search (▶).\n\nUse Results or History on the left, and manage additional StarDict dictionaries from the Dictionaries tab."; font-family: "Noto Sans"; font-size: 11px; color: #45637d; wrap: word-wrap; } } }
      Rectangle { vertical-stretch: 1; background: transparent; }
     } } }
    } }
   }
   if root.active-tab == 1 : VerticalLayout { padding: 6px; spacing: 5px; SectionTitle { text: root.ui-lang == "vi" ? "Dịch văn bản trực tuyến" : "Text Translation"; } HorizontalLayout { height: 27px; spacing: 5px; Text { text: root.ui-lang == "vi" ? "Từ:" : "From:"; width: 35px; color: #174d7b; } LineEdit { width: 75px; text <=> root.translate-from-lang; } Text { text: root.ui-lang == "vi" ? "Đến:" : "To:"; width: 35px; } LineEdit { width: 75px; text <=> root.translate-to-lang; } Text { text: root.ui-lang == "vi" ? "Bộ dịch:" : "Engine:"; width: 55px; } LineEdit { width: 110px; text <=> root.translate-engine; } Rectangle { horizontal-stretch: 1; } ClassicButton { text: root.is-translating ? (root.ui-lang == "vi" ? "Hủy" : "Cancel") : (root.ui-lang == "vi" ? "Dịch ngay" : "Translate"); width: 86px; clicked => { if root.is-translating { root.cancel-translation(); } else { root.translate(root.translate-source-text, root.translate-from-lang, root.translate-to-lang, root.translate-engine); } } } } HorizontalLayout { spacing: 5px; vertical-stretch: 1; Rectangle { horizontal-stretch: 1; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px; SectionTitle { text: root.ui-lang == "vi" ? "Văn bản gốc" : "Source Text"; } TextEdit { text <=> root.translate-source-text; vertical-stretch: 1; } } } Rectangle { horizontal-stretch: 1; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px; HorizontalLayout { height: 27px; Text { text: root.ui-lang == "vi" ? "Bản dịch" : "Translation"; color: #174d7b; font-weight: 700; } Rectangle { horizontal-stretch: 1; } ClassicButton { text: root.ui-lang == "vi" ? "Phát âm" : "Speak"; clicked => { root.speak(root.translate-target-text, root.translate-to-lang); } } ClassicButton { text: root.ui-lang == "vi" ? "Dừng" : "Stop"; clicked => { root.stop-tts(); } } ClassicButton { text: root.ui-lang == "vi" ? "Sao chép" : "Copy"; clicked => { root.copy-to-clipboard(root.translate-target-text); } } } TextEdit { text <=> root.translate-target-text; vertical-stretch: 1; } } } } }
   if root.active-tab == 2 : VerticalLayout { padding: 6px; spacing: 5px; SectionTitle { text: root.ui-lang == "vi" ? "Quản lý từ điển" : "Dictionary Management"; } Rectangle { height: 65px; background: #eef5fa; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 5px; Text { text: root.ui-lang == "vi" ? "Cài đặt từ điển StarDict (.ifo), MDict (.mdx), hoặc TSV" : "Install a StarDict (.ifo), MDict (.mdx), or TSV dictionary"; color: #174d7b; } HorizontalLayout { spacing: 5px; LineEdit { text <=> root.import-path; placeholder-text: root.ui-lang == "vi" ? "Đường dẫn file từ điển" : "Dictionary file path"; horizontal-stretch: 2; } LineEdit { text <=> root.import-name; placeholder-text: root.ui-lang == "vi" ? "Tên hiển thị (tùy chọn)" : "Display name"; } ClassicButton { text: root.ui-lang == "vi" ? "Nhập từ điển" : "Import"; clicked => { root.import-dictionary(root.import-path, root.import-name); } } } } } Rectangle { vertical-stretch: 1; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px; SectionTitle { text: root.ui-lang == "vi" ? "Danh sách từ điển đã cài" : "Installed Dictionaries"; } ListView { for dict in root.dictionaries : Rectangle { height: 43px; border-color: #d5e0e8; border-width: 1px; HorizontalLayout { padding: 6px; spacing: 6px; VerticalLayout { horizontal-stretch: 1; Text { text: dict.name; color: #173f61; font-weight: 700; } Text { text: dict.format + " | " + dict.entry-count + (root.ui-lang == "vi" ? " mục từ | " : " entries | ") + (dict.enabled ? (root.ui-lang == "vi" ? "Đang bật" : "Enabled") : (root.ui-lang == "vi" ? "Đã tắt" : "Disabled")); color: #58758b; font-size: 10px; } } ClassicButton { text: dict.enabled ? (root.ui-lang == "vi" ? "Tắt" : "Disable") : (root.ui-lang == "vi" ? "Bật" : "Enable"); clicked => { root.toggle-dictionary(dict.id, !dict.enabled); } } ClassicButton { text: root.ui-lang == "vi" ? "Xóa" : "Delete"; clicked => { root.delete-dictionary(dict.id); } } } } } } } }
   if root.active-tab == 3 : ScrollView { VerticalLayout { padding: 6px; spacing: 5px; SectionTitle { text: root.ui-lang == "vi" ? "Cài đặt & Ngôn ngữ giao diện" : "Settings & Language"; } Rectangle { height: 68px; background: #f4f9fd; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 7px; spacing: 6px; Text { text: root.ui-lang == "vi" ? "Ngôn ngữ giao diện (Interface Language)" : "Interface Language (Ngôn ngữ giao diện)"; color: #174d7b; font-weight: 700; } HorizontalLayout { spacing: 8px; ClassicButton { text: "🇻🇳 Tiếng Việt"; width: 110px; height: 24px; selected: root.ui-lang == "vi"; clicked => { root.ui-lang = "vi"; root.change-language("vi"); } } ClassicButton { text: "🇬🇧 English"; width: 100px; height: 24px; selected: root.ui-lang == "en"; clicked => { root.ui-lang = "en"; root.change-language("en"); } } } } } Rectangle { height: 182px; background: #f4f9fd; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 7px; spacing: 5px; Text { text: root.ui-lang == "vi" ? "Tự động bắt chữ" : "Automatic Capture"; color: #174d7b; font-weight: 700; } CheckBox { text: root.ui-lang == "vi" ? "Tra cứu tự động khi sao chép vào clipboard" : "Look up text copied to the clipboard"; checked <=> root.clipboard-monitor-enabled; toggled => { root.toggle-clipboard-monitor(self.checked); } } CheckBox { text: root.ui-lang == "vi" ? "Bắt chữ dưới con trỏ chuột bằng UI Automation" : "Capture words under the pointer using UI Automation"; checked <=> root.cursor-capture-enabled; toggled => { root.configure-capture(self.checked, root.selection-capture-enabled, root.ocr-fallback-enabled); } } CheckBox { text: root.ui-lang == "vi" ? "Bắt chữ khi bôi đen hoặc nháy đúp chuột" : "Capture selected or double-clicked text"; checked <=> root.selection-capture-enabled; toggled => { root.configure-capture(root.cursor-capture-enabled, self.checked, root.ocr-fallback-enabled); } } CheckBox { text: root.ui-lang == "vi" ? "Cho phép nhận dạng ký tự quang học (OCR fallback)" : "Allow OCR fallback"; checked <=> root.ocr-fallback-enabled; toggled => { root.configure-capture(root.cursor-capture-enabled, root.selection-capture-enabled, self.checked); } } CheckBox { text: root.ui-lang == "vi" ? "Tự động phát âm sau khi tra nhanh" : "Pronounce automatically after quick lookup"; checked <=> root.auto-pronounce-enabled; toggled => { root.toggle-auto-pronounce(self.checked); } } } } Rectangle { height: 176px; background: #f4f9fd; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 7px; spacing: 6px; Text { text: root.ui-lang == "vi" ? "Dịch trực tuyến & AI" : "Online Translation and AI"; color: #174d7b; font-weight: 700; } HorizontalLayout { Text { text: root.ui-lang == "vi" ? "Địa chỉ API (Base URL):" : "Base URL:"; width: 145px; } LineEdit { text <=> root.openai-base-url; } } HorizontalLayout { Text { text: root.ui-lang == "vi" ? "Mô hình (Model):" : "Model:"; width: 145px; } LineEdit { text <=> root.openai-model; } } HorizontalLayout { Text { text: root.ui-lang == "vi" ? "Khóa API (API key):" : "API key:"; width: 145px; } LineEdit { text <=> root.openai-api-key; } } HorizontalLayout { Text { text: root.ui-lang == "vi" ? "Ngôn ngữ đích mặc định:" : "Default target language:"; width: 145px; } LineEdit { text <=> root.default-target-lang; } } } } } }
   }
   Rectangle { height: 22px; background: root.status-is-error ? #f8e5e5 : #e1edf5; border-color: root.status-is-error ? #c99191 : #91aec3; border-width: 1px; HorizontalLayout { padding-left: 6px; padding-right: 6px; Text { text: root.status-text; color: root.status-is-error ? #9a2525 : #174d7b; font-family: "Noto Sans"; font-size: 11px; vertical-alignment: center; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: root.private-mode ? (root.ui-lang == "vi" ? "Riêng tư" : "Private") : (root.ui-lang == "vi" ? "Sẵn sàng" : "Ready"); color: #58758b; font-size: 10px; vertical-alignment: center; } } }
 }

  if root.active-menu > 0 : TouchArea {
   x: 0px; y: 0px; width: root.width; height: root.height;
   clicked => { root.active-menu = 0; }
  }

  // Menu 1: File
  if root.active-menu == 1 : Rectangle {
   x: 4px; y: 48px; width: 220px;
   background: #ffffff; border-color: #7ba3c4; border-width: 1px; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000030;
   VerticalLayout { padding: 3px; spacing: 1px;
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Tra từ mới" : "New Search"; icon-text: "🔍"; shortcut: "Ctrl+N";
     clicked => { root.query = ""; root.active-tab = 0; root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Dịch văn bản" : "Text Translation"; icon-text: "🌐"; shortcut: "Ctrl+T";
     clicked => { root.active-tab = 1; root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Quản lý từ điển" : "Dictionaries"; icon-text: "📚"; shortcut: "Ctrl+D";
     clicked => { root.active-tab = 2; root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Cài đặt & Tùy biến" : "Preferences"; icon-text: "⚙"; shortcut: "Ctrl+P";
     clicked => { root.active-tab = 3; root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Lưu kết quả ra HTML" : "Export HTML"; icon-text: "💾"; shortcut: "Ctrl+S";
     clicked => { root.export-result-html(); root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Thoát ứng dụng" : "Exit"; icon-text: "✕"; shortcut: "Alt+F4";
     clicked => { root.exit-app(); root.active-menu = 0; }
    }
   }
  }

  // Menu 2: Edit
  if root.active-menu == 2 : Rectangle {
   x: 52px; y: 48px; width: 220px;
   background: #ffffff; border-color: #7ba3c4; border-width: 1px; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000030;
   VerticalLayout { padding: 3px; spacing: 1px;
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Sao chép định nghĩa" : "Copy Definition"; icon-text: "📋"; shortcut: "Ctrl+C";
     clicked => { root.copy-to-clipboard(root.selected-headword + "\n" + root.selected-definition); root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Phát âm từ này" : "Pronounce Word"; icon-text: "🔊"; shortcut: "F7";
     clicked => { root.speak(root.selected-headword, "en"); root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Dừng phát âm" : "Stop Speech"; icon-text: "⏹";
     clicked => { root.stop-tts(); root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Xóa lịch sử tra cứu" : "Clear History"; icon-text: "🗑";
     clicked => { root.clear-history(); root.active-menu = 0; }
    }
   }
  }

  // Menu 3: View
  if root.active-menu == 3 : Rectangle {
   x: 118px; y: 48px; width: 210px;
   background: #ffffff; border-color: #7ba3c4; border-width: 1px; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000030;
   VerticalLayout { padding: 3px; spacing: 1px;
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Danh sách Kết quả" : "Results List"; icon-text: "📑"; is-checked: !root.show-history-tab && root.active-tab == 0;
     clicked => { root.show-history-tab = false; root.active-tab = 0; root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Lịch sử tra cứu" : "Search History"; icon-text: "🕒"; is-checked: root.show-history-tab && root.active-tab == 0;
     clicked => { root.show-history-tab = true; root.active-tab = 0; root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Trang Tra cứu từ điển" : "Lookup Tab"; icon-text: "📖"; is-checked: root.active-tab == 0;
     clicked => { root.active-tab = 0; root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Trang Dịch văn bản" : "Translation Tab"; icon-text: "🌐"; is-checked: root.active-tab == 1;
     clicked => { root.active-tab = 1; root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Trang Quản lý từ điển" : "Dictionaries Tab"; icon-text: "📚"; is-checked: root.active-tab == 2;
     clicked => { root.active-tab = 2; root.active-menu = 0; }
    }
   }
  }

  // Menu 4: Options
  if root.active-menu == 4 : Rectangle {
   x: 172px; y: 48px; width: 230px;
   background: #ffffff; border-color: #7ba3c4; border-width: 1px; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000030;
   VerticalLayout { padding: 3px; spacing: 1px;
    MenuDropdownItem {
     text: "Tiếng Việt"; icon-text: "🇻🇳"; is-checked: root.ui-lang == "vi";
     clicked => { root.ui-lang = "vi"; root.change-language("vi"); root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: "English"; icon-text: "🇬🇧"; is-checked: root.ui-lang == "en";
     clicked => { root.ui-lang = "en"; root.change-language("en"); root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Tự động bắt chữ Clipboard" : "Auto Match Clipboard"; icon-text: "📋"; is-checked: root.clipboard-monitor-enabled;
     clicked => { root.clipboard-monitor-enabled = !root.clipboard-monitor-enabled; root.toggle-clipboard-monitor(root.clipboard-monitor-enabled); root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Chế độ riêng tư" : "Private Mode"; icon-text: "🔒"; is-checked: root.private-mode;
     clicked => { root.private-mode = !root.private-mode; root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Bảng Cài đặt chi tiết..." : "Detailed Settings..."; icon-text: "⚙";
     clicked => { root.active-tab = 3; root.active-menu = 0; }
    }
   }
  }

  // Menu 5: Help
  if root.active-menu == 5 : Rectangle {
   x: 232px; y: 48px; width: 240px;
   background: #ffffff; border-color: #7ba3c4; border-width: 1px; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000030;
   VerticalLayout { padding: 3px; spacing: 1px;
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Giới thiệu Lingoes RS..." : "About Lingoes RS..."; icon-text: "ℹ";
     clicked => { root.show-about-dialog = true; root.active-menu = 0; }
    }
    MenuDropdownItem { is-separator: true; }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Kho mã nguồn GitHub" : "GitHub Repository"; icon-text: "🌐";
     clicked => { root.open-url("https://github.com/anhdddl/lingoes-rs"); root.active-menu = 0; }
    }
    MenuDropdownItem {
     text: root.ui-lang == "vi" ? "Tải bản cập nhật mới nhất" : "Download Latest Release"; icon-text: "📦";
     clicked => { root.open-url("https://github.com/anhdddl/lingoes-rs/releases"); root.active-menu = 0; }
    }
   }
  }

  // MODAL ABOUT DIALOG
  if root.show-about-dialog : Rectangle {
   x: 0px; y: 0px; width: root.width; height: root.height; background: #0000004d;
   TouchArea { clicked => { root.show-about-dialog = false; } }
   Rectangle {
    x: (parent.width - 450px) / 2; y: (parent.height - 310px) / 2; width: 450px; height: 310px;
    background: #ffffff; border-color: #2b70a7; border-width: 2px; border-radius: 4px;
    drop-shadow-blur: 16px; drop-shadow-color: #00000060;
    VerticalLayout {
     Rectangle {
      height: 32px; background: #2570ab;
      HorizontalLayout { padding-left: 12px; padding-right: 12px;
       Text { text: root.ui-lang == "vi" ? "Thông tin về Lingoes RS" : "About Lingoes RS"; color: white; font-family: "Noto Sans"; font-size: 13px; font-weight: 700; vertical-alignment: center; }
       Rectangle { horizontal-stretch: 1; }
       Text { text: "✕"; color: #d6e9f8; font-size: 13px; vertical-alignment: center; TouchArea { clicked => { root.show-about-dialog = false; } } }
      }
     }
     VerticalLayout { padding: 16px; spacing: 10px;
      HorizontalLayout { spacing: 12px;
       Rectangle { width: 48px; height: 48px; border-radius: 24px; background: #4caf50;
        Rectangle { x: 6px; y: 6px; width: 24px; height: 24px; border-radius: 12px; background: #fdd835; }
        Rectangle { x: 26px; y: 10px; width: 16px; height: 14px; background: #f44336; }
       }
       VerticalLayout { spacing: 2px;
        Text { text: "Lingoes RS"; font-family: "Noto Sans"; font-size: 18px; font-weight: 700; color: #174d7b; }
        Text { text: "Phiên bản 0.1.2 (Windows x64 Portable & Linux)"; font-family: "Noto Sans"; font-size: 11px; color: #58758b; }
        Text { text: root.ui-lang == "vi" ? "Từ điển máy tính để bàn thế hệ mới bằng Rust & Slint" : "Next-generation Desktop Dictionary in Rust & Slint"; font-family: "Noto Sans"; font-size: 11px; font-italic: true; color: #3d76a5; }
       }
      }
      Rectangle { height: 1px; background: #dce7f0; }
      Text {
       text: root.ui-lang == "vi"
        ? "• Tích hợp sẵn 403.887 mục từ:\n   - Từ điển Anh - Việt tổng hợp (228.613 từ)\n   - Từ điển Việt - Anh OVDP (42.103 từ)\n   - Từ điển Việt - Anh SPDict (133.171 từ)\n• Hỗ trợ gõ tiếng Việt có dấu, không dấu, tìm cụm từ 2-4 chữ\n• Tra cứu tiền tố thời gian thực & tìm kiếm định nghĩa nâng cao (FTS5)\n• Phát hành mã nguồn mở theo giấy phép MIT."
        : "• Integrated with 403,887 dictionary entries:\n   - English - Vietnamese Comprehensive (228,613 entries)\n   - Vietnamese - English OVDP (42,103 entries)\n   - Vietnamese - English SPDict (133,171 entries)\n• Accent-insensitive Vietnamese typing (có dấu & không dấu), multi-word search\n• Real-time prefix search & advanced full-text search (FTS5)\n• Open-source released under the MIT License.";
       font-family: "Noto Sans"; font-size: 11px; color: #263238; wrap: word-wrap;
      }
      Rectangle { vertical-stretch: 1; }
      HorizontalLayout {
       Rectangle { horizontal-stretch: 1; }
       ClassicButton { text: root.ui-lang == "vi" ? "Đóng" : "Close"; width: 80px; height: 26px; clicked => { root.show-about-dialog = false; } }
      }
     }
    }
   }
  }
}
