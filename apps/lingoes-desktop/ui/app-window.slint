import { CheckBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";
export struct SearchResult { headword: string, definition: string, dictionary-name: string, }
export struct DictionaryItem { id: int, name: string, format: string, entry-count: int, enabled: bool, }
component ClassicButton inherits Rectangle {
 in property <string> text; in property <bool> enabled: true; in property <bool> selected: false; callback clicked;
 height: 24px; min-width: 43px; background: !enabled ? #e8edf1 : selected ? #b7d7ef : hit.has-hover ? #f4f9fd : #dceaf5; border-color: selected ? #4f8db8 : #91acc1; border-width: 1px;
 Text { text: root.text; color: root.enabled ? #174d7b : #8293a0; font-family: "Tahoma"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; x: 3px; width: parent.width - 6px; height: parent.height; overflow: elide; }
 hit := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component SectionTitle inherits Rectangle { in property <string> text; height: 27px; background: #d8e9f6; border-color: #9ebbd0; border-width: 1px; Text { text: root.text; x: 7px; width: parent.width - 14px; height: parent.height; color: #174d7b; font-family: "Tahoma"; font-size: 12px; font-weight: 700; vertical-alignment: center; } }
export component AppWindow inherits Window {
 title: "Lingoes RS - Từ Điển & Dịch Thuật"; preferred-width: 960px; preferred-height: 660px; min-width: 780px; min-height: 500px; background: white;
 in-out property <int> active-tab: 0;
 in-out property <string> query; in property <[SearchResult]> results; in property <int> selected-index: -1; in property <string> selected-headword; in property <string> selected-definition; in property <string> selected-dict-badge; in property <bool> can-go-back: false; in property <bool> can-go-forward: false; in-out property <bool> private-mode: false; in-out property <int> active-group-index: 0; in-out property <bool> show-history-tab: false; in property <[string]> history-items;
 in-out property <string> translate-source-text; in-out property <string> translate-target-text; in-out property <string> translate-from-lang: "auto"; in-out property <string> translate-to-lang: "vi"; in-out property <string> translate-engine: "google"; in property <bool> is-translating: false;
 in property <[DictionaryItem]> dictionaries; in-out property <string> import-path; in-out property <string> import-name;
 in-out property <bool> clipboard-monitor-enabled: false; in-out property <bool> cursor-capture-enabled: false; in-out property <bool> selection-capture-enabled: false; in-out property <bool> ocr-fallback-enabled: false; in-out property <string> openai-base-url: "http://localhost:20128/v1"; in-out property <string> openai-model: "auto"; in-out property <string> openai-api-key: ""; in-out property <string> default-target-lang: "vi";
 in property <string> status-text: "Sẵn sàng"; in property <bool> status-is-error: false; in-out property <bool> auto-pronounce-enabled: false;
 callback search(string); callback full-text-search(string); callback select-result(int); callback speak(string, string); callback stop-tts(); callback copy-to-clipboard(string); callback export-result-html(); callback translate(string, string, string, string); callback import-dictionary(string, string); callback toggle-dictionary(int, bool); callback delete-dictionary(int); callback toggle-clipboard-monitor(bool); callback toggle-auto-pronounce(bool); callback configure-capture(bool, bool, bool);
 VerticalLayout { spacing: 0px;
  Rectangle { height: 27px; background: #2385c3; HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; Text { text: "Lingoes"; color: white; font-family: "Tahoma"; font-size: 17px; font-weight: 700; vertical-alignment: center; } Text { text: "Dictionary and Text Translation"; color: #d9f0ff; font-family: "Tahoma"; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: #2385c3; } Text { text: "Lingoes RS"; color: white; font-size: 11px; vertical-alignment: center; } } }
  Rectangle { height: 48px; background: #c9e0f2; border-color: #86a7c0; border-width: 1px; VerticalLayout { padding: 3px; spacing: 2px;
   HorizontalLayout { height: 16px; spacing: 15px; Text { text: "File"; color: #173f61; font-size: 11px; } Text { text: "Edit"; color: #173f61; font-size: 11px; } Text { text: "View"; color: #173f61; font-size: 11px; } Text { text: "Options"; color: #173f61; font-size: 11px; } Text { text: "Help"; color: #173f61; font-size: 11px; } Rectangle { horizontal-stretch: 1; } }
   HorizontalLayout { spacing: 3px; ClassicButton { text: "Dictionary"; width: 75px; selected: root.active-tab == 0; clicked => { root.active-tab = 0; } } ClassicButton { text: "Text Translation"; width: 100px; selected: root.active-tab == 1; clicked => { root.active-tab = 1; } } ClassicButton { text: "Dictionaries"; width: 77px; selected: root.active-tab == 2; clicked => { root.active-tab = 2; } } ClassicButton { text: "Settings"; width: 60px; selected: root.active-tab == 3; clicked => { root.active-tab = 3; } } Rectangle { width: 1px; background: #8aa8be; } ClassicButton { text: "Auto Match"; width: 72px; selected: root.clipboard-monitor-enabled; clicked => { root.clipboard-monitor-enabled = !root.clipboard-monitor-enabled; root.toggle-clipboard-monitor(root.clipboard-monitor-enabled); } } ClassicButton { text: "Private"; width: 53px; selected: root.private-mode; clicked => { root.private-mode = !root.private-mode; } } Rectangle { horizontal-stretch: 1; } }
  } }
  Rectangle { height: 35px; background: #e5f0f8; border-color: #9eb7c9; border-width: 1px; HorizontalLayout { padding: 3px; spacing: 3px; ClassicButton { text: "<"; width: 27px; enabled: root.can-go-back; } ClassicButton { text: ">"; width: 27px; enabled: root.can-go-forward; } Rectangle { horizontal-stretch: 1; background: white; border-color: #668aa5; border-width: 1px; HorizontalLayout { padding-left: 2px; LineEdit { text <=> root.query; placeholder-text: "Type a word or phrase"; accepted => { root.search(self.text); } } Rectangle { width: 22px; background: #e2edf5; Text { text: "v"; color: #174d7b; horizontal-alignment: center; vertical-alignment: center; } } } } ClassicButton { text: "Search  >"; width: 71px; selected: true; clicked => { root.search(root.query); } } ClassicButton { text: "Web Search"; width: 72px; clicked => { root.full-text-search(root.query); } } ClassicButton { text: "Text Translation"; width: 98px; clicked => { root.active-tab = 1; } } ClassicButton { text: "Speak"; width: 45px; enabled: root.query != ""; clicked => { root.speak(root.query, "en"); } } } }
  Rectangle { vertical-stretch: 1; background: white;
   if root.active-tab == 0 : HorizontalLayout { spacing: 2px;
    Rectangle { width: 236px; background: #eef5fa; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px;
     HorizontalLayout { height: 30px; spacing: 1px; ClassicButton { text: "Index"; selected: !root.show-history-tab && root.active-group-index == 0; clicked => { root.show-history-tab = false; root.active-group-index = 0; } } ClassicButton { text: "Guide"; selected: !root.show-history-tab && root.active-group-index == 1; clicked => { root.show-history-tab = false; root.active-group-index = 1; } } ClassicButton { text: "Appendix"; selected: !root.show-history-tab && root.active-group-index == 2; clicked => { root.show-history-tab = false; root.active-group-index = 2; } } ClassicButton { text: "History"; selected: root.show-history-tab; clicked => { root.show-history-tab = true; } } }
     Rectangle { height: 3px; background: #55dd00; }
     Rectangle { vertical-stretch: 1; background: white; border-color: #a8bbc9; border-width: 1px; if root.show-history-tab : ListView { for item in root.history-items : Rectangle { height: 23px; background: hhit.has-hover ? #f4f9fd : white; Text { text: item; x: 7px; width: parent.width - 14px; height: parent.height; color: #173f61; font-size: 12px; vertical-alignment: center; overflow: elide; } hhit := TouchArea { clicked => { root.query = item; root.search(item); } } } } if !root.show-history-tab : ListView { for result[index] in root.results : Rectangle { height: 25px; background: index == root.selected-index ? #cce7fa : rhit.has-hover ? #f4f9fd : white; border-color: #edf2f5; border-width: 1px; Text { text: result.headword; x: 7px; width: parent.width - 14px; height: parent.height; color: #173f61; font-size: 12px; vertical-alignment: center; overflow: elide; } rhit := TouchArea { clicked => { root.select-result(index); } } } } }
    } }
    Rectangle { horizontal-stretch: 1; background: white; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px;
     Rectangle { height: 29px; background: #dcecf7; border-color: #9ab4c7; border-width: 1px; HorizontalLayout { padding-left: 5px; padding-right: 3px; spacing: 3px; Text { text: root.selected-headword == "" ? "Start Page" : root.selected-headword; color: #174d7b; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; } if root.selected-dict-badge != "" : Text { text: "[" + root.selected-dict-badge + "]"; color: #58758b; font-size: 10px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } ClassicButton { text: "Speak"; width: 44px; height: 21px; enabled: root.selected-headword != ""; clicked => { root.speak(root.selected-headword, "en"); } } ClassicButton { text: "Stop"; width: 37px; height: 21px; clicked => { root.stop-tts(); } } ClassicButton { text: "Copy"; width: 40px; height: 21px; enabled: root.selected-headword != ""; clicked => { root.copy-to-clipboard(root.selected-headword + "\n" + root.selected-definition); } } ClassicButton { text: "Save"; width: 39px; height: 21px; enabled: root.selected-headword != ""; clicked => { root.export-result-html(); } } ClassicButton { text: "Find"; width: 37px; height: 21px; clicked => { root.full-text-search(root.query); } } } }
     ScrollView { vertical-stretch: 1; Rectangle { background: white; min-height: 420px; Text { text: root.selected-definition == "" ? "Welcome to Lingoes RS\n\nEnter a word in the search box above, then press Enter or click Search." : root.selected-definition; x: 14px; y: 12px; width: parent.width - 28px; color: #172f43; font-family: "Tahoma"; font-size: 13px; wrap: word-wrap; } } }
    } }
   }
   if root.active-tab == 1 : VerticalLayout { padding: 6px; spacing: 5px; SectionTitle { text: "Text Translation"; } HorizontalLayout { height: 27px; spacing: 5px; Text { text: "From:"; width: 35px; color: #174d7b; } LineEdit { width: 75px; text <=> root.translate-from-lang; } Text { text: "To:"; width: 20px; } LineEdit { width: 75px; text <=> root.translate-to-lang; } Text { text: "Engine:"; width: 45px; } LineEdit { width: 110px; text <=> root.translate-engine; } Rectangle { horizontal-stretch: 1; } ClassicButton { text: root.is-translating ? "Translating..." : "Translate"; width: 78px; clicked => { root.translate(root.translate-source-text, root.translate-from-lang, root.translate-to-lang, root.translate-engine); } } } HorizontalLayout { spacing: 5px; vertical-stretch: 1; Rectangle { horizontal-stretch: 1; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px; SectionTitle { text: "Source Text"; } TextEdit { text <=> root.translate-source-text; vertical-stretch: 1; } } } Rectangle { horizontal-stretch: 1; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px; HorizontalLayout { height: 27px; Text { text: "Translation"; color: #174d7b; font-weight: 700; } Rectangle { horizontal-stretch: 1; } ClassicButton { text: "Speak"; clicked => { root.speak(root.translate-target-text, root.translate-to-lang); } } ClassicButton { text: "Stop"; clicked => { root.stop-tts(); } } ClassicButton { text: "Copy"; clicked => { root.copy-to-clipboard(root.translate-target-text); } } } TextEdit { text <=> root.translate-target-text; vertical-stretch: 1; } } } } }
   if root.active-tab == 2 : VerticalLayout { padding: 6px; spacing: 5px; SectionTitle { text: "Dictionary Management"; } Rectangle { height: 65px; background: #eef5fa; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 5px; Text { text: "Install a StarDict (.ifo), MDict (.mdx), or TSV dictionary"; color: #174d7b; } HorizontalLayout { spacing: 5px; LineEdit { text <=> root.import-path; placeholder-text: "Dictionary file path"; horizontal-stretch: 2; } LineEdit { text <=> root.import-name; placeholder-text: "Display name"; } ClassicButton { text: "Import"; clicked => { root.import-dictionary(root.import-path, root.import-name); } } } } } Rectangle { vertical-stretch: 1; border-color: #91aec3; border-width: 1px; VerticalLayout { spacing: 0px; SectionTitle { text: "Installed Dictionaries"; } ListView { for dict in root.dictionaries : Rectangle { height: 43px; border-color: #d5e0e8; border-width: 1px; HorizontalLayout { padding: 6px; spacing: 6px; VerticalLayout { horizontal-stretch: 1; Text { text: dict.name; color: #173f61; font-weight: 700; } Text { text: dict.format + " | " + dict.entry-count + " entries | " + (dict.enabled ? "Enabled" : "Disabled"); color: #58758b; font-size: 10px; } } ClassicButton { text: dict.enabled ? "Disable" : "Enable"; clicked => { root.toggle-dictionary(dict.id, !dict.enabled); } } ClassicButton { text: "Delete"; clicked => { root.delete-dictionary(dict.id); } } } } } } } }
   if root.active-tab == 3 : ScrollView { VerticalLayout { padding: 6px; spacing: 5px; SectionTitle { text: "Settings and Capture"; } Rectangle { height: 182px; background: #f4f9fd; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 7px; spacing: 5px; Text { text: "Automatic Capture"; color: #174d7b; font-weight: 700; } CheckBox { text: "Look up text copied to the clipboard"; checked <=> root.clipboard-monitor-enabled; toggled => { root.toggle-clipboard-monitor(self.checked); } } CheckBox { text: "Capture words under the pointer using UI Automation"; checked <=> root.cursor-capture-enabled; toggled => { root.configure-capture(self.checked, root.selection-capture-enabled, root.ocr-fallback-enabled); } } CheckBox { text: "Capture selected or double-clicked text"; checked <=> root.selection-capture-enabled; toggled => { root.configure-capture(root.cursor-capture-enabled, self.checked, root.ocr-fallback-enabled); } } CheckBox { text: "Allow OCR fallback"; checked <=> root.ocr-fallback-enabled; toggled => { root.configure-capture(root.cursor-capture-enabled, root.selection-capture-enabled, self.checked); } } CheckBox { text: "Pronounce automatically after quick lookup"; checked <=> root.auto-pronounce-enabled; toggled => { root.toggle-auto-pronounce(self.checked); } } } } Rectangle { height: 176px; background: #f4f9fd; border-color: #9eb7c9; border-width: 1px; VerticalLayout { padding: 7px; spacing: 6px; Text { text: "Online Translation and AI"; color: #174d7b; font-weight: 700; } HorizontalLayout { Text { text: "Base URL:"; width: 145px; } LineEdit { text <=> root.openai-base-url; } } HorizontalLayout { Text { text: "Model:"; width: 145px; } LineEdit { text <=> root.openai-model; } } HorizontalLayout { Text { text: "API key:"; width: 145px; } LineEdit { text <=> root.openai-api-key; } } HorizontalLayout { Text { text: "Default target language:"; width: 145px; } LineEdit { text <=> root.default-target-lang; } } } } } }
  }
  Rectangle { height: 22px; background: root.status-is-error ? #f8e5e5 : #e1edf5; border-color: root.status-is-error ? #c99191 : #91aec3; border-width: 1px; HorizontalLayout { padding-left: 6px; padding-right: 6px; Text { text: root.status-text; color: root.status-is-error ? #9a2525 : #174d7b; font-family: "Tahoma"; font-size: 11px; vertical-alignment: center; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: root.private-mode ? "Private" : "Ready"; color: #58758b; font-size: 10px; vertical-alignment: center; } } }
 }
}
