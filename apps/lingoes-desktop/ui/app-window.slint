import { Button, CheckBox, LineEdit, ScrollView, ListView, TextEdit } from "std-widgets.slint";

export struct SearchResult {
    headword: string,
    definition: string,
    dictionary-name: string,
}

export struct DictionaryItem {
    id: int,
    name: string,
    format: string,
    entry-count: int,
    enabled: bool,
}

export component AppWindow inherits Window {
    title: "Lingoes RS - Từ Điển & Dịch Thuật";
    preferred-width: 960px;
    preferred-height: 660px;
    min-width: 780px;
    min-height: 500px;

    // Navigation
    in-out property <int> active-tab: 0;

    // Tab 0: Lookup
    in-out property <string> query;
    in property <[SearchResult]> results;
    in property <int> selected-index: -1;
    in property <string> selected-headword;
    in property <string> selected-definition;
    in property <string> selected-dict-badge;
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in-out property <bool> private-mode: false;
    in-out property <int> active-group-index: 0;
    in-out property <bool> show-history-tab: false;
    in property <[string]> history-items;

    // Tab 1: Translate
    in-out property <string> translate-source-text;
    in-out property <string> translate-target-text;
    in-out property <string> translate-from-lang: "auto";
    in-out property <string> translate-to-lang: "vi";
    in-out property <string> translate-engine: "google";
    in property <bool> is-translating: false;

    // Tab 2: Dictionaries
    in property <[DictionaryItem]> dictionaries;
    in-out property <string> import-path;
    in-out property <string> import-name;

    // Tab 3: Settings
    in-out property <bool> clipboard-monitor-enabled: false;
    in-out property <string> openai-base-url: "http://localhost:20128/v1";
    in-out property <string> openai-model: "auto";
    in-out property <string> openai-api-key: "";
    in-out property <string> default-target-lang: "vi";

    // Quick Popup
    in-out property <bool> show-quick-popup: false;
    in-out property <string> quick-popup-headword;
    in-out property <string> quick-popup-definition;

    // Status bar
    in property <string> status-text: "Sẵn sàng";
    in property <bool> status-is-error: false;

    // Callbacks
    callback search(string);
    callback full-text-search(string);
    callback select-result(int);
    callback speak(string, string);
    callback copy-to-clipboard(string);
    callback export-result-html();
    callback translate(string, string, string, string);
    callback import-dictionary(string, string);
    callback toggle-dictionary(int, bool);
    callback delete-dictionary(int);
    callback toggle-clipboard-monitor(bool);
    callback dismiss-quick-popup();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Header and Tab Navigation Bar
        HorizontalLayout {
            spacing: 12px;
            height: 42px;

            Text {
                text: "Lingoes RS";
                font-size: 22px;
                font-weight: 800;
                color: #0f3d64;
                vertical-alignment: center;
            }

            Rectangle { width: 16px; }

            // Tab 0 button
            Rectangle {
                border-radius: 6px;
                background: root.active-tab == 0 ? #0f3d64 : #e2e8f0;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: "📖 Tra cứu";
                    font-weight: 600;
                    font-size: 14px;
                    color: root.active-tab == 0 ? #ffffff : #334155;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 0; } }
            }

            // Tab 1 button
            Rectangle {
                border-radius: 6px;
                background: root.active-tab == 1 ? #0f3d64 : #e2e8f0;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: "🌐 Dịch trực tuyến";
                    font-weight: 600;
                    font-size: 14px;
                    color: root.active-tab == 1 ? #ffffff : #334155;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 1; } }
            }

            // Tab 2 button
            Rectangle {
                border-radius: 6px;
                background: root.active-tab == 2 ? #0f3d64 : #e2e8f0;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: "📚 Quản lý từ điển";
                    font-weight: 600;
                    font-size: 14px;
                    color: root.active-tab == 2 ? #ffffff : #334155;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 2; } }
            }

            // Tab 3 button
            Rectangle {
                border-radius: 6px;
                background: root.active-tab == 3 ? #0f3d64 : #e2e8f0;
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: "⚙️ Cài đặt & Bắt chữ";
                    font-weight: 600;
                    font-size: 14px;
                    color: root.active-tab == 3 ? #ffffff : #334155;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea { clicked => { root.active-tab = 3; } }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // Tab Contents Container
        Rectangle {
            vertical-stretch: 1;

            // TAB 0: DICTIONARY LOOKUP
            if root.active-tab == 0 : VerticalLayout {
                spacing: 10px;

                // Search inputs
                HorizontalLayout {
                    spacing: 8px;
                    height: 38px;

                    search-input := LineEdit {
                        text <=> root.query;
                        placeholder-text: "Nhập từ cần tra…";
                        accepted => { root.search(self.text); }
                        edited => { root.search(self.text); }
                    }
                    Button {
                        text: "Tra từ";
                        clicked => { root.search(root.query); }
                    }
                    Button {
                        text: "Toàn văn (FTS)";
                        clicked => { root.full-text-search(root.query); }
                    }
                }

                // Two columns: Result List & Detail View
                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;

                    // Results sidebar
                    VerticalLayout {
                        width: 320px;
                        spacing: 6px;

                        Text {
                            text: "Kết quả tra cứu";
                            font-weight: 600;
                            color: #334155;
                        }

                        ListView {
                            for result[index] in root.results : Rectangle {
                                height: 50px;
                                background: index == root.selected-index ? #dbeafe : #ffffff;
                                border-color: #cbd5e1;
                                border-width: 1px;
                                border-radius: 4px;

                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 2px;

                                    Text {
                                        text: result.headword;
                                        font-weight: 700;
                                        font-size: 14px;
                                        color: #0f172a;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: result.dictionary-name == "" ? "Mặc định" : result.dictionary-name;
                                        font-size: 11px;
                                        color: #64748b;
                                        overflow: elide;
                                    }
                                }

                                TouchArea { clicked => { root.select-result(index); } }
                            }
                        }
                    }

                    // Detail Pane
                    Rectangle {
                        border-color: #cbd5e1;
                        border-width: 1px;
                        border-radius: 6px;
                        background: #f8fafc;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            // Header row with actions
                            HorizontalLayout {
                                spacing: 10px;
                                height: 36px;

                                Text {
                                    text: root.selected-headword == "" ? "Chưa chọn từ" : root.selected-headword;
                                    font-size: 22px;
                                    font-weight: 800;
                                    color: #0f3d64;
                                    vertical-alignment: center;
                                }

                                if root.selected-dict-badge != "" : Rectangle {
                                    border-radius: 4px;
                                    background: #e0f2fe;
                                    border-color: #7dd3fc;
                                    border-width: 1px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.selected-dict-badge;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #0369a1;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                if root.selected-headword != "" : Button {
                                    text: "🔊 Phát âm";
                                    clicked => { root.speak(root.selected-headword, "en"); }
                                }
                                if root.selected-headword != "" : Button {
                                    text: "📋 Sao chép";
                                    clicked => {
                                        root.copy-to-clipboard(root.selected-headword + "\n" + root.selected-definition);
                                    }
                                }
                                if root.selected-headword != "" : Button {
                                    text: "🌐 Xuất HTML";
                                    clicked => { root.export-result-html(); }
                                }
                            }

                            // Rich-entry badges. Definitions remain selectable text in Slint;
                            // standalone export preserves sanitized formatting and tables.
                            if root.selected-headword != "" : HorizontalLayout {
                                spacing: 8px;
                                height: 28px;
                                Rectangle {
                                    border-radius: 5px;
                                    background: #f1f5f9;
                                    border-color: #cbd5e1;
                                    border-width: 1px;
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    Text {
                                        text: "🔤 phonetic";
                                        font-size: 11px;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    border-radius: 5px;
                                    background: #e0e7ff;
                                    border-color: #c7d2fe;
                                    border-width: 1px;
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    Text {
                                        text: "POS";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #4338ca;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            // Definition body
                            ScrollView {
                                vertical-stretch: 1;
                                Text {
                                    text: root.selected-definition == "" ? "Nhập từ khóa và bấm tìm kiếm hoặc chọn từ bên trái." : root.selected-definition;
                                    wrap: word-wrap;
                                    font-size: 14px;
                                    color: #1e293b;
                                }
                            }
                        }
                    }
                }
            }

            // TAB 1: ONLINE TRANSLATION
            if root.active-tab == 1 : VerticalLayout {
                spacing: 12px;

                // Translation controls
                HorizontalLayout {
                    spacing: 10px;
                    height: 38px;

                    Text {
                        text: "Từ:";
                        vertical-alignment: center;
                        font-weight: 600;
                    }
                    LineEdit {
                        width: 90px;
                        text <=> root.translate-from-lang;
                        placeholder-text: "auto / en";
                    }

                    Text {
                        text: "➔ Sang:";
                        vertical-alignment: center;
                        font-weight: 600;
                    }
                    LineEdit {
                        width: 90px;
                        text <=> root.translate-to-lang;
                        placeholder-text: "vi";
                    }

                    Text {
                        text: "Máy dịch:";
                        vertical-alignment: center;
                        font-weight: 600;
                    }
                    LineEdit {
                        width: 130px;
                        text <=> root.translate-engine;
                        placeholder-text: "google / openai";
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: root.is-translating ? "Đang dịch…" : "🌐 Dịch văn bản";
                        clicked => {
                            root.translate(root.translate-source-text, root.translate-from-lang, root.translate-to-lang, root.translate-engine);
                        }
                    }
                }

                // Two columns: Source text and Target text
                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;

                    // Source Editor
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Văn bản gốc";
                            font-weight: 600;
                            color: #334155;
                        }

                        TextEdit {
                            text <=> root.translate-source-text;
                            vertical-stretch: 1;
                        }
                    }

                    // Target View
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            height: 28px;
                            Text {
                                text: "Kết quả dịch";
                                font-weight: 600;
                                color: #334155;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if root.translate-target-text != "" : Button {
                                text: "🔊 Nghe";
                                clicked => { root.speak(root.translate-target-text, root.translate-to-lang); }
                            }
                            if root.translate-target-text != "" : Button {
                                text: "📋 Sao chép";
                                clicked => { root.copy-to-clipboard(root.translate-target-text); }
                            }
                        }

                        TextEdit {
                            text <=> root.translate-target-text;
                            vertical-stretch: 1;
                        }
                    }
                }
            }

            // TAB 2: DICTIONARY MANAGER
            if root.active-tab == 2 : VerticalLayout {
                spacing: 14px;

                // Import Card
                Rectangle {
                    border-radius: 6px;
                    border-color: #cbd5e1;
                    border-width: 1px;
                    background: #f8fafc;
                    height: 110px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Nhập từ điển mới (StarDict .ifo, MDict .mdx, TSV .tsv)";
                            font-weight: 700;
                            color: #0f3d64;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.import-path;
                                placeholder-text: "Đường dẫn file từ điển (.tsv, .ifo, .mdx)";
                                horizontal-stretch: 2;
                            }
                            LineEdit {
                                text <=> root.import-name;
                                placeholder-text: "Tên từ điển (tùy chọn)";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "📥 Nhập từ điển";
                                clicked => { root.import-dictionary(root.import-path, root.import-name); }
                            }
                        }
                    }
                }

                // Dictionaries List
                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    Text {
                        text: "Từ điển đã cài đặt";
                        font-weight: 700;
                        color: #334155;
                    }

                    ListView {
                        for dict in root.dictionaries : Rectangle {
                            height: 56px;
                            border-color: #e2e8f0;
                            border-width: 1px;
                            border-radius: 6px;
                            background: #ffffff;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: dict.name;
                                            font-weight: 700;
                                            font-size: 15px;
                                            color: #0f172a;
                                        }
                                        Rectangle {
                                            border-radius: 4px;
                                            background: #f1f5f9;
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: dict.format;
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #475569;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "\{dict.entry-count} mục | ID: \{dict.id} | Trạng thái: " + (dict.enabled ? "Kích hoạt" : "Đã tắt");
                                        font-size: 12px;
                                        color: dict.enabled ? #16a34a : #94a3b8;
                                    }
                                }

                                Button {
                                    text: dict.enabled ? "Tắt" : "Bật";
                                    clicked => { root.toggle-dictionary(dict.id, !dict.enabled); }
                                }

                                Button {
                                    text: "Xóa";
                                    clicked => { root.delete-dictionary(dict.id); }
                                }
                            }
                        }
                    }
                }
            }

            // TAB 3: SETTINGS & CAPTURE
            if root.active-tab == 3 : VerticalLayout {
                spacing: 16px;

                // Clipboard capture setting
                Rectangle {
                    border-radius: 6px;
                    border-color: #cbd5e1;
                    border-width: 1px;
                    background: #f8fafc;
                    padding: 14px;

                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Bắt chữ tự động (Clipboard Capture)";
                            font-weight: 700;
                            font-size: 16px;
                            color: #0f3d64;
                        }

                        CheckBox {
                            text: "Tự động tra khi sao chép văn bản (Auto-lookup on Copy)";
                            checked <=> root.clipboard-monitor-enabled;
                            toggled => { root.toggle-clipboard-monitor(self.checked); }
                        }

                        Text {
                            text: "Khi kích hoạt, bất cứ đoạn văn bản nào bạn sao chép (Ctrl+C) sẽ tự động được gửi tới Lingoes để tra cứu nhanh.";
                            font-size: 13px;
                            color: #64748b;
                        }
                    }
                }

                // AI / Translation settings
                Rectangle {
                    border-radius: 6px;
                    border-color: #cbd5e1;
                    border-width: 1px;
                    background: #f8fafc;
                    padding: 14px;

                    VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "Cấu hình AI & Máy dịch trực tuyến";
                            font-weight: 700;
                            font-size: 16px;
                            color: #0f3d64;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "OpenAI / Local LLM Base URL:";
                                width: 220px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.openai-base-url;
                                placeholder-text: "http://localhost:20128/v1";
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Model dịch:";
                                width: 220px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.openai-model;
                                placeholder-text: "auto (hoặc gpt-4o-mini, llama-3...)";
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "API Key (nếu có):";
                                width: 220px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.openai-api-key;
                                placeholder-text: "sk-... (tùy chọn)";
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Ngôn ngữ đích mặc định:";
                                width: 220px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.default-target-lang;
                                placeholder-text: "vi";
                            }
                        }
                    }
                }

                // App info
                Rectangle {
                    border-radius: 6px;
                    background: #eff6ff;
                    border-color: #bfdbfe;
                    border-width: 1px;
                    padding: 14px;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Lingoes RS - Modern High Performance Cross-Platform Dictionary Engine";
                            font-weight: 700;
                            color: #1e40af;
                        }
                        Text {
                            text: "Phiên bản: 0.1.0 | Công nghệ: Rust 2024, Slint UI, SQLite FTS5, Google & LLM Translator";
                            font-size: 12px;
                            color: #3b82f6;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // Quick Popup Overlay
            if root.show-quick-popup : Rectangle {
                x: parent.width - 360px;
                y: parent.height - 200px;
                width: 340px;
                height: 180px;
                border-radius: 8px;
                background: #ffffff;
                border-color: #0f3d64;
                border-width: 2px;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000030;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 26px;
                        Text {
                            text: "⚡ Tra nhanh: " + root.quick-popup-headword;
                            font-weight: 800;
                            font-size: 15px;
                            color: #0f3d64;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "✕";
                            clicked => { root.dismiss-quick-popup(); }
                        }
                    }

                    Text {
                        text: root.quick-popup-definition;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: #334155;
                        vertical-stretch: 1;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Chi tiết";
                            clicked => {
                                root.active-tab = 0;
                                root.query = root.quick-popup-headword;
                                root.search(root.quick-popup-headword);
                                root.dismiss-quick-popup();
                            }
                        }
                        Button {
                            text: "🔊 Nghe";
                            clicked => { root.speak(root.quick-popup-headword, "en"); }
                        }
                    }
                }
            }
        }

        // Bottom Status Bar
        Rectangle {
            height: 32px;
            border-radius: 4px;
            background: root.status-is-error ? #fef2f2 : #f0f9ff;
            border-color: root.status-is-error ? #fecaca : #bae6fd;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.status-text;
                    color: root.status-is-error ? #b91c1c : #0369a1;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
